{
  "name": "wheres-the-rest-video",
  "private": true,
  "description": "Video production for the Where's the Rest? hackathon demo (Remotion + Playwright capture).",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts WheresTheRest out/wheres-the-rest.mp4",
    "render:preview": "remotion render src/index.ts WheresTheRest out/preview.mp4 --frames=0-450",
    "captions:srt": "node tools/build-srt.mjs"
  },
  "dependencies": {
    "@remotion/cli": "4.0.543",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remotion": "4.0.543"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "@types/react": "19.3.0",
    "playwright": "1.65.1",
    "typescript": "5.9.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
